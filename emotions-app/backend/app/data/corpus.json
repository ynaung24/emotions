  "evaluation_criteria": {
    "relevance": {
      "description": "How directly the answer addresses the question asked",
      "weight": 0.26
    },
    "completeness": {
      "description": "How many of the points a strong answer would cover are present",
      "weight": 0.37
    },
    "specificity": {
      "description": "Concrete detail - named tools, numbers, and examples rather than generalities",
      "weight": 0.13
    },
    "structure": {
      "description": "Situation / Task / Action / Result arc, for behavioural questions",
      "weight": 0.16
    },
    "clarity": {
      "description": "Readability and sentence structure",
      "weight": 0.04
    },
    "confidence": {
      "description": "Assertive phrasing, low on hedging and filler",
      "weight": 0.02
    },
    "conciseness": {
      "description": "Substance without padding or repetition",
      "weight": 0.02
    }
