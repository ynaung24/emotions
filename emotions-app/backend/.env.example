# Copy to .env (or set in the environment). All keys are optional - the app runs
# with sensible defaults and no LLM judge.

# --- CORS (JSON list) ---
# EVAL_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- data / model cache (defaults resolve to the repo root) ---
# EVAL_CORPUS_PATH=/app/data/corpus.json
# EVAL_MODEL_CACHE_DIR=/app/model_cache

# --- feature flags ---
# EVAL_ENABLE_EMOTION=true
# EVAL_WARMUP_ON_STARTUP=true

# --- optional LLM judge -------------------------------------------------------
# Adds written narrative feedback on top of the deterministic scores. With no key
# set, feedback is template-only and everything else works unchanged.
#
# EVAL_JUDGE_PROVIDER=auto        # auto | claude | openai | none
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# EVAL_JUDGE_MODEL_CLAUDE=claude-haiku-4-5
# EVAL_JUDGE_MODEL_OPENAI=gpt-4o-mini
